# Google OAuth callback used by the backend.
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:1911/api/v1/auth/google/callback

# Supabase Cloud: configure these two values in Supabase Dashboard > Authentication > Providers > Google.
# Do not commit real values into this repository.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Confirm these URLs in Supabase Dashboard > Authentication > URL Configuration.
APP_BASE_URL=http://localhost:1911
FRONTEND_URL=http://localhost:3000
